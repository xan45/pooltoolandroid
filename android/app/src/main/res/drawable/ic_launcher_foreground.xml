<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. CUE STICK CROSSING BEHIND THE BALL (DIAGONAL) -->
    <!-- Cue Shaft (Maple/Gold Tapered Wood) -->
    <path
        android:pathData="M18,88 L88,18 M20,90 L90,20"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="18"
                android:startY="88"
                android:endX="88"
                android:endY="18"
                android:type="linear">
                <item android:color="#FF8A5A2B" android:offset="0.0" />
                <item android:color="#FFD4AF37" android:offset="0.5" />
                <item android:color="#FFF0E6C8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Cue Brass Ferrule Accent Ring -->
    <path
        android:pathData="M78,28 L82,24"
        android:strokeWidth="6"
        android:strokeColor="#FFE6C200"
        android:strokeLineCap="butt" />
    <!-- Cue Tip -->
    <path
        android:pathData="M83,23 L85,21"
        android:strokeWidth="5"
        android:strokeColor="#FF3A2012"
        android:strokeLineCap="round" />

    <!-- 2. EMERALD GREEN POOL CLOTH ACCENT CRESCENT BEHIND BALL -->
    <path
        android:pathData="M30,58 C30,72 40,82 54,82 C68,82 78,72 78,58 C72,66 64,70 54,70 C44,70 36,66 30,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="58"
                android:endX="54"
                android:endY="82"
                android:type="linear">
                <item android:color="#FF0B6E4F" android:offset="0.0" />
                <item android:color="#FF043324" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. REALISTIC 3D BLACK 8-BALL BODY (Center: 54, 50, Radius: 23) -->
    <!-- Drop Shadow behind Ball -->
    <path
        android:pathData="M54,53m-23,0a23,23 0,1 1,46 0a23,23 0,1 1,-46 0"
        android:fillColor="#60000000" />

    <!-- Ball Base sphere -->
    <path
        android:pathData="M54,50m-23,0a23,23 0,1 1,46 0a23,23 0,1 1,-46 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="47"
                android:centerY="43"
                android:gradientRadius="24"
                android:type="radial">
                <item android:color="#FF2C2C2C" android:offset="0.0" />
                <item android:color="#FF111111" android:offset="0.65" />
                <item android:color="#FF050505" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Metallic Gold Outer Rim Ring on Ball -->
    <path
        android:pathData="M54,50m-22.5,0a22.5,22.5 0,1 1,45 0a22.5,22.5 0,1 1,-45 0"
        android:strokeWidth="0.8"
        android:strokeColor="#40D4AF37"
        android:fillColor="#00000000" />

    <!-- 4. WHITE 8-CIRCLE (Center: 54, 50, Radius: 9.5) -->
    <path
        android:pathData="M54,50m-9.5,0a9.5,9.5 0,1 1,19 0a9.5,9.5 0,1 1,-19 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="52"
                android:centerY="48"
                android:gradientRadius="10"
                android:type="radial">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#FFE8E8E8" android:offset="0.85" />
                <item android:color="#FFD0D0D0" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 5. CRISP NUMBER "8" DIGIT IN CENTER OF BALL -->
    <!-- Top loop of 8 -->
    <path
        android:pathData="M54,46.2m-2.8,0a2.8,2.8 0,1 1,5.6 0a2.8,2.8 0,1 1,-5.6 0"
        android:strokeWidth="1.8"
        android:strokeColor="#FF111111"
        android:fillColor="#00000000" />
    <!-- Bottom loop of 8 -->
    <path
        android:pathData="M54,53.2m-3.3,0a3.3,3.3 0,1 1,6.6 0a3.3,3.3 0,1 1,-6.6 0"
        android:strokeWidth="1.9"
        android:strokeColor="#FF111111"
        android:fillColor="#00000000" />

    <!-- 6. GLOSSY WHITE SPECULAR HIGHLIGHT REFLECTION -->
    <!-- Curved Top-Left Resin Reflection Gloss -->
    <path
        android:pathData="M39,36 C42,32 49,30 55,31 C50,32 44,35 41,39 C40,38 39,37 39,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="39"
                android:startY="30"
                android:endX="55"
                android:endY="39"
                android:type="linear">
                <item android:color="#99FFFFFF" android:offset="0.0" />
                <item android:color="#10FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Small Secondary Dot Reflection -->
    <path
        android:pathData="M36,42m-1.2,0a1.2,1.2 0,1 1,2.4 0a1.2,1.2 0,1 1,-2.4 0"
        android:fillColor="#55FFFFFF" />
</vector>
